# Copy this file to .env and fill in the key.
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
#
# Get a key from https://console.mistral.ai  (free tier is enough for the demo).
# Never commit the real .env file.

MISTRAL_API_KEY=

# Set to 1 to force the offline fallbacks even when a key is present.
# Useful for rehearsing without burning API calls — but remember that output
# produced in offline mode is extractive, not generated.
OFFLINE_MODE=0
