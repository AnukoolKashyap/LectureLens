# --- secrets -----------------------------------------------------------
# .env holds the Mistral API key. Never commit it; .env.example is the
# template that goes in the repo instead.
.env
.streamlit/secrets.toml

# --- virtual environments ----------------------------------------------
.venv/
venv/
env/

# --- Python ------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- generated at runtime ----------------------------------------------
# The vector store and the exported summaries are rebuilt from any video,
# so they are output, not source. The folders themselves are kept.
data/
exports/
!data/.gitkeep
!exports/.gitkeep

# --- editors and OS ----------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# --- scratch -----------------------------------------------------------
_to_delete/
